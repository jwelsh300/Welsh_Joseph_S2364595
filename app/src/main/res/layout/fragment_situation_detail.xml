<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ===== Heading ===== -->
        <TextView
            android:id="@+id/detailCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorSecondary"
            tools:text="Incident" />
        <TextView
            android:id="@+id/detailType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="Queuing traffic" />

        <!-- ===== Location ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:text="Location" />
        <LinearLayout
            android:id="@+id/rowRoad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorSecondary"
                android:text="Road" />
            <TextView
                android:id="@+id/detailRoad"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                tools:text="M8" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/rowDirection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorSecondary"
                android:text="Direction" />
            <TextView
                android:id="@+id/detailDirection"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                tools:text="Eastbound" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/rowFrom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorSecondary"
                android:text="From" />
            <TextView
                android:id="@+id/detailFrom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                tools:text="M8 J19 Kingston Bridge (East)\nJunction J19" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/rowTo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorSecondary"
                android:text="To" />
            <TextView
                android:id="@+id/detailTo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                tools:text="M8 J18 Charing Cross\nJunction J18" />
        </LinearLayout>

        <!-- ===== Timing ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:text="Timing" />
        <LinearLayout
            android:id="@+id/rowStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorSecondary"
                android:text="Start" />
            <TextView
                android:id="@+id/detailStart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                tools:text="2026-11-06T10:12:32+00:00" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/rowEnd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorSecondary"
                android:text="End" />
            <TextView
                android:id="@+id/detailEnd"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                tools:text="2027-12-31T23:59:00+00:00" />
        </LinearLayout>

        <!-- ===== Impact ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:text="Impact" />
        <LinearLayout
            android:id="@+id/rowLanes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorSecondary"
                android:text="Lanes" />
            <TextView
                android:id="@+id/detailLanes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                tools:text="2 lanes restricted" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/rowDelay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorSecondary"
                android:text="Delays" />
            <TextView
                android:id="@+id/detailDelay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                tools:text="Long delays" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/rowUrgent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorSecondary"
                android:text="Urgent" />
            <TextView
                android:id="@+id/detailUrgent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                tools:text="No" />
        </LinearLayout>

        <!-- ===== Comment ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:text="Details" />
        <TextView
            android:id="@+id/detailComment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            tools:text="The A6091 is closed Eastbound at Galafoot Bridge to allow for essential roadworks. Diversions are in place." />

        <!-- ===== Reference ===== -->
        <TextView
            android:id="@+id/detailId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary"
            tools:text="Ref: I_20261106_185" />
    </LinearLayout>
</ScrollView>